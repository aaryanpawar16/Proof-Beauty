# --- YouCam API (https://yce.makeupar.com/api-console/en/api-keys/) ---
# Leave empty to run in DEMO mode (simulated analysis + renders, zero credits spent).
YOUCAM_API_KEY=
YOUCAM_API_BASE=https://yce-api-01.makeupar.com/s2s/v2.0
# Set to 1 to use the simulated demo engine even though a key is set (spends no credits).
# FORCE_DEMO=1

# Credit pool the app's own counter works against. The app refuses a run its counter says it can't afford.
CREDIT_BUDGET=1000
# Credits per YouCam task, MEASURED from a real usage export (YouCam console > usage > export):
#   skin-analysis ~10 per task, skin-tone-analysis 20 per task, makeup-vto 1 per render.
# A full run is therefore ~74 credits with the tone API (~54 without it; see USE_TONE_API), ~96 with a refinement round.
UNIT_COST_SKIN_ANALYSIS=10
UNIT_COST_SKIN_TONE=20
UNIT_COST_MAKEUP_VTO=1
# The tone API is 20 credits (27% of a run), often fails on tilted faces, and a free local fallback exists.
# Off by default. Set to 1 for YouCam's lighting-corrected tone (better product shades) on runs that matter.
# USE_TONE_API=1

# YouCam skin-analysis ui_score: true = higher means healthier skin (less visible concern).
# The probe script (npm run probe) verifies this on a real photo.
UI_SCORE_HIGHER_IS_BETTER=true

# Which YouCam score to measure with: raw_score (default) or ui_score.
# ui_score is a compressed display value: a clearly visible makeup change moved it ~3 points, but moved
# raw_score ~8-11 points, at similar noise. Measured with near-identical photos (re-encode / 4px shift /
# +3% brightness): raw_score noise was about 0.5-2.4 points. Run `npm run probe` to check on your own photo.
SCORE_FIELD=raw_score

# Test-retest noise band in score points. Changes smaller than this are reported as "within noise".
NOISE_BAND=2

# One refinement round runs only if the best look hasn't CLEARLY improved the top concern (change beyond 2x its
# noise band). Optionally also require at least this fraction of severity removed (0 = off).
COVERAGE_TARGET=0

# Local LLM (Ollama) writes the plain-language explanation. Scores are always computed in code.
# Setup: install Ollama, then `ollama pull llama2`. If Ollama isn't running, a built-in template is used.
# Set OLLAMA_MODEL= (empty) to skip the LLM entirely.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama2
OLLAMA_TIMEOUT_MS=60000

# Optional JSON override of the role -> makeup-vto {category, pattern} map. See src/lib/patterns.ts
# PATTERN_OVERRIDES={"under_eye_correct":{"category":"concealer","pattern":"1"}}

# --- Deploying on Vercel (leave all of these empty for local dev: it uses ./.data on disk) ---
# Photos: a PRIVATE Vercel Blob store connected to the project. Vercel adds BLOB_STORE_ID (+ OIDC) automatically;
# set BLOB_READ_WRITE_TOKEN yourself only if you run outside Vercel.
# BLOB_READ_WRITE_TOKEN=
# Ledger, analysis cache and rate limit: any Upstash Redis (Vercel Marketplace adds KV_REST_API_URL / KV_REST_API_TOKEN).
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# Protects /api/cron/purge (the daily photo cleanup). Any long random string.
# CRON_SECRET=
# On Vercel set OLLAMA_MODEL= (empty) above: there is no local Ollama, so the built-in template writes the explanation.
# On a fresh Redis the credit counter starts at 0: set CREDIT_BUDGET to the credits you really have left.

# Per-IP limit on credit-spending runs (a full run is ~54 credits). Default: 3/hour in production, off in dev.
# 0 turns it off. Uses Redis when configured (shared across instances), else in-memory per process. Stage 2 allows 2x this.
# RATE_LIMIT_RUNS=3
# RATE_LIMIT_WINDOW_MIN=60
# Set to 1 ONLY behind a reverse proxy that sets X-Forwarded-For (Vercel, Fly, nginx...). Otherwise every
# visitor is counted as one client.
# TRUST_PROXY=1

# Photos are deleted after this many minutes.
SESSION_TTL_MINUTES=60
